# ============================================================
# NewtronLabs / 3D Printing Wallah — Environment Variables Template
# Copy this file to .env.local for local development.
# ============================================================

# 1. Application & Domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 2. Neon PostgreSQL Database
# Pooled connection string (with PgBouncer) used by the application runtime:
DATABASE_URL="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/newtronlabs?sslmode=require&pgbouncer=true"

# Direct connection string used by Prisma CLI for migrations:
DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/newtronlabs?sslmode=require"

# 3. Cloudflare R2 Object Storage (Private Bucket for 3D Models)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_s3_api_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_s3_api_secret_access_key"
R2_BUCKET_NAME="newtronlabs-models-private"
# Optional public custom domain for catalog image CDN:
# R2_PUBLIC_DOMAIN="models.3dprintingwallah.com"

# 4. Authentication (NextAuth.js / Auth.js v5)
# Generate with: openssl rand -hex 32
AUTH_SECRET="development_auth_secret_must_be_at_least_32_characters_long"
AUTH_TRUST_HOST="true"

# 5. Transactional Email Services (Resend or SMTP)
# Resend API Key:
RESEND_API_KEY=""

# Standard SMTP Alternative:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Workshop Notifications Destination:
BUSINESS_EMAIL="support@newtronlabs.in"
NOTIFICATION_EMAIL="workshop@newtronlabs.in"
