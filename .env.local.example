# ============================================================
# NewtronLabs Local Development Environment Variables (.env.local)
# Safe placeholder defaults for local development
# ============================================================

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# When DATABASE_URL is left empty or unconfigured, the application
# gracefully activates the MockService fallback mode.
DATABASE_URL=""
DIRECT_URL=""

# Cloudflare R2 Mock / Development Fallback
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="newtronlabs-models-private"

# Local Auth Secret
AUTH_SECRET="local_dev_secret_0123456789abcdef0123456789abcdef"
AUTH_TRUST_HOST="true"

# Local Email Simulation (logs to terminal when unconfigured)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
BUSINESS_EMAIL="support@newtronlabs.in"
NOTIFICATION_EMAIL="workshop@newtronlabs.in"
